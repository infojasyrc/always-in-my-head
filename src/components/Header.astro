---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header class="site-header">
    <nav>
        <div class="nav-bar">
            <h2><a href="/">{SITE_TITLE}</a></h2>
            <button
                type="button"
                class="menu-toggle"
                aria-expanded="false"
                aria-controls="site-menu"
            >
                <span class="menu-toggle-label sr-only">Abrir menú</span>
                <span class="hamburger" aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                </span>
            </button>
        </div>
        <div class="internal-links" id="site-menu">
            <HeaderLink href="/">Home</HeaderLink>
            <HeaderLink href="/blog">Blog</HeaderLink>
            <HeaderLink href="/about">About</HeaderLink>
        </div>
        <div class="social-links">
            <a href="https://x.com/devinfojas" target="_blank">
                <span class="sr-only">No me sigas en X :D</span>
                <svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
                    ><path
                        fill="currentColor"
                        d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"
                    ></path></svg
                >
            </a>
        </div>
    </nav>
</header>
<script>
    const header = document.querySelector('.site-header');
    const toggle = header?.querySelector('.menu-toggle');
    const menu = header?.querySelector('#site-menu');
    const label = toggle?.querySelector('.menu-toggle-label');

    const setOpen = (open: boolean) => {
        if (!toggle || !menu || !label) return;
        toggle.setAttribute('aria-expanded', String(open));
        menu.classList.toggle('is-open', open);
        label.textContent = open ? 'Cerrar menú' : 'Abrir menú';
    };

    toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        setOpen(!open);
    });

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setOpen(false);
    });

    menu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setOpen(false));
    });
</script>
<style>
    header {
        margin: 0;
        padding: 0 1em;
        background: white;
        box-shadow: 0 2px 8px rgba(var(--black), 5%);
    }
    h2 {
        margin: 0;
        font-size: 1em;
        min-width: 0;
    }
    h2 a,
    h2 a.active {
        text-decoration: none;
    }
    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
    }
    .nav-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        min-width: 0;
    }
    nav a {
        padding: 1em 0.5em;
        color: var(--black);
        border-bottom: 4px solid transparent;
        text-decoration: none;
    }
    nav a.active {
        text-decoration: none;
        border-bottom-color: var(--accent);
    }
    .internal-links {
        display: none;
        flex-direction: column;
        align-items: stretch;
        width: 100%;
        flex-basis: 100%;
        padding-bottom: 0.5em;
    }
    .internal-links.is-open {
        display: flex;
    }
    .internal-links a {
        padding: 0.75em 0.25em;
    }
    .menu-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-left: auto;
        min-width: 44px;
        min-height: 44px;
        padding: 0;
        border: 0;
        background: transparent;
        color: rgb(var(--black));
        cursor: pointer;
    }
    .hamburger {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        width: 1.25rem;
        height: 0.875rem;
    }
    .hamburger span {
        display: block;
        height: 2px;
        width: 100%;
        background: currentColor;
        border-radius: 1px;
        transition:
            transform 0.2s ease,
            opacity 0.2s ease;
    }
    .menu-toggle[aria-expanded='true'] .hamburger span:nth-child(1) {
        transform: translateY(6px) rotate(45deg);
    }
    .menu-toggle[aria-expanded='true'] .hamburger span:nth-child(2) {
        opacity: 0;
    }
    .menu-toggle[aria-expanded='true'] .hamburger span:nth-child(3) {
        transform: translateY(-6px) rotate(-45deg);
    }
    .social-links,
    .social-links a {
        display: flex;
    }
    @media (max-width: 720px) {
        .social-links {
            display: none;
        }
    }
    @media (min-width: 481px) {
        .nav-bar {
            width: auto;
            flex: 1;
        }
        .menu-toggle {
            display: none;
        }
        .internal-links,
        .internal-links.is-open {
            display: flex;
            flex-direction: row;
            align-items: center;
            width: auto;
            flex-basis: auto;
            flex-shrink: 0;
            padding-bottom: 0;
        }
        .internal-links a {
            padding: 1em 0.5em;
        }
    }
    @media (max-width: 480px) {
        header {
            padding: 0 0.75em;
        }
        .nav-bar {
            width: 100%;
        }
        h2 a {
            white-space: nowrap;
        }
    }
</style>
